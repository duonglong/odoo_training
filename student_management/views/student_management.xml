<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="student_list_view">
            <field name="name">Student List View</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="class_room_id"/>
                </list>
            </field>
        </record>
        <record model="ir.ui.view" id="student_form_view">
            <field name="name">Student Form View</field>
            <field name="model">student.student</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="class_room_id"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="student_action">
            <field name="name">Student</field>
            <field name="res_model">student.student</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="Student management" id="student_management_root"/>
        <menuitem id="student_management_student" name="Students" action="student_action"
              parent="student_management_root"/>
    </data>
</odoo>