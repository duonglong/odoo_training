<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="class_room_list_view">
            <field name="name">Class Room List View</field>
            <field name="model">student.classroom</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="student_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>
        <record model="ir.ui.view" id="class_room_form_view">
            <field name="name">Class Room Form View</field>
            <field name="model">student.classroom</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                    </header>
                    <group>
                        <group>
                            <field name="name"/>

                        </group>
                        <group>
                        </group>
                        <notebook>
                            <page string="Student">
                                <field name="student_m2m_ids" domain="[('age', '>=', 16)]">
                                    <list>
                                        <field name="name"/>
                                        <field name="age"/>
                                        <field name="date_of_birth"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="class_room_action">
            <field name="name">Class Room</field>
            <field name="res_model">student.classroom</field>
            <field name="view_mode">list,form</field>
        </record>


    </data>
</odoo>