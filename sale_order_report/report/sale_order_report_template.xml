<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_sale_order_batch_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- ══ Title ══════════════════════════════════════ -->
                        <div class="row mb-4">
                            <div class="col-7">
                                <h2 class="mb-0">Sale Order</h2>
                                <span class="text-muted fs-4" t-field="doc.name"/>
                            </div>
                            <div class="col-5 text-end">
                                <table class="table table-sm table-borderless w-auto ms-auto">
                                    <tr>
                                        <td class="text-muted pe-2">Order Date</td>
                                        <td>
                                            <strong>
                                                <span t-field="doc.date_order"
                                                      t-options='{"widget": "date"}'/>
                                            </strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted pe-2">Status</td>
                                        <td>
                                            <strong>
                                                <span t-field="doc.state"/>
                                            </strong>
                                        </td>
                                    </tr>
                                    <t t-if="doc.validity_date">
                                        <tr>
                                            <td class="text-muted pe-2">Valid Until</td>
                                            <td>
                                                <span t-field="doc.validity_date"
                                                      t-options='{"widget": "date"}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                            </div>
                        </div>

                        <!-- ══ Customer / Delivery Info ═══════════════════ -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <div class="border rounded p-3 h-100">
                                    <p class="fw-bold mb-1 text-muted small">
                                        BILL TO
                                    </p>
                                    <p class="mb-0">
                                        <strong t-field="doc.partner_id.name"/>
                                        <br/>
                                        <t t-if="doc.partner_id.street">
                                            <span t-field="doc.partner_id.street"/>
                                            <br/>
                                        </t>
                                        <t t-if="doc.partner_id.city">
                                            <span t-field="doc.partner_id.city"/>
                                            <t t-if="doc.partner_id.state_id">
                                                ,
                                                <span t-field="doc.partner_id.state_id.name"/>
                                            </t>
                                            <br/>
                                        </t>
                                        <t t-if="doc.partner_id.country_id">
                                            <span t-field="doc.partner_id.country_id.name"/>
                                        </t>
                                    </p>
                                </div>
                            </div>
                            <div class="col-6">
                                <t t-if="doc.partner_shipping_id
                                     and doc.partner_shipping_id != doc.partner_id">
                                    <div class="border rounded p-3 h-100">
                                        <p class="fw-bold mb-1 text-muted small">
                                            SHIP TO
                                        </p>
                                        <p class="mb-0">
                                            <strong t-field="doc.partner_shipping_id.name"/>
                                            <br/>
                                            <t t-if="doc.partner_shipping_id.street">
                                                <span t-field="doc.partner_shipping_id.street"/>
                                                <br/>
                                            </t>
                                            <t t-if="doc.partner_shipping_id.city">
                                                <span t-field="doc.partner_shipping_id.city"/>
                                                <br/>
                                            </t>
                                            <t t-if="doc.partner_shipping_id.country_id">
                                                <span t-field="doc.partner_shipping_id.country_id.name"/>
                                            </t>
                                        </p>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- ══ Order Lines ════════════════════════════════ -->
                        <table class="table table-sm table-bordered">
                            <thead style="background-color: #f8f9fa;">
                                <tr>
                                    <th style="width: 5%">#</th>
                                    <th style="width: 30%">Product</th>
                                    <th style="width: 25%">Description</th>
                                    <th class="text-end" style="width: 10%">Qty</th>
                                    <th class="text-end" style="width: 15%">Unit Price</th>
                                    <th class="text-end" style="width: 10%">Disc%</th>
                                    <th class="text-end" style="width: 15%">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <!-- Skip section/note lines differently -->
                                    <t t-if="line.display_type == 'line_section'">
                                        <tr>
                                            <td colspan="7" class="fw-bold bg-light">
                                                <span t-field="line.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-elif="line.display_type == 'line_note'">
                                        <tr>
                                            <td colspan="7" class="text-muted fst-italic">
                                                <span t-field="line.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td>
                                                <t t-out="line_index + 1"/>
                                            </td>
                                            <td>
                                                <span t-field="line.product_id.name"/>
                                            </td>
                                            <td class="text-muted small">
                                                <span t-field="line.name"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.product_uom_qty"/>
                                                <span t-field="line.product_uom_id.name"
                                                      class="text-muted small ms-1"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.price_unit"
                                                      t-options='{"widget": "monetary",
                                                    "display_currency": doc.currency_id}'/>
                                            </td>
                                            <td class="text-end">
                                                <t t-if="line.discount">
                                                    <span t-field="line.discount"/>%
                                                </t>
                                                <t t-else="">—</t>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.price_subtotal"
                                                      t-options='{"widget": "monetary",
                                                    "display_currency": doc.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <!-- ══ Totals ══════════════════════════════════════ -->
                        <div class="row justify-content-end mt-2">
                            <div class="col-5">
                                <table class="table table-sm">
                                    <tr>
                                        <td>Untaxed Amount</td>
                                        <td class="text-end">
                                            <span t-field="doc.amount_untaxed"
                                                  t-options='{"widget": "monetary",
                                                "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Taxes</td>
                                        <td class="text-end">
                                            <span t-field="doc.amount_tax"
                                                  t-options='{"widget": "monetary",
                                                "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr class="fw-bold border-top">
                                        <td>Total</td>
                                        <td class="text-end">
                                            <span t-field="doc.amount_total"
                                                  t-options='{"widget": "monetary",
                                                "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ══ Notes ══════════════════════════════════════ -->
                        <t t-if="doc.note">
                            <div class="mt-3 border-top pt-3">
                                <p class="fw-bold mb-1">Notes</p>
                                <p t-field="doc.note" class="text-muted"/>
                            </div>
                        </t>

                    </div>
                </t>
            </t>

        </t>
    </template>
</odoo>