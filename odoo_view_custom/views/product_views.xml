<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. The view record itself -->
    <record id="view_product_card_gallery" model="ir.ui.view">
        <field name="name">product.template.card_gallery</field>
        <field name="model">product.template</field>
        <field name="type">card_gallery</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <card_gallery/>
        </field>
    </record>

    <!-- 2. The action — view_mode must list card_gallery -->
    <record id="action_product_card_gallery" model="ir.actions.act_window">
        <field name="name">Products - Card Gallery</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">card_gallery,list,form</field>
    </record>

    <!-- 3. Explicitly link the view to the action -->
    <record id="action_product_card_gallery_view_card" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">card_gallery</field>
        <field name="view_id" ref="view_product_card_gallery"/>
        <field name="act_window_id" ref="action_product_card_gallery"/>
    </record>

    <record id="action_product_card_gallery_view_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">list</field>
        <field name="act_window_id" ref="action_product_card_gallery"/>
    </record>

    <record id="action_product_card_gallery_view_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="act_window_id" ref="action_product_card_gallery"/>
    </record>


    <record id="product_template_form_view_rating" model="ir.ui.view">
        <field name="name">Product Template Inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="rating" widget="star_rating" string="Rating"/>
            </xpath>
        </field>
    </record>

    <!-- 4. Menu item -->
    <menuitem
            id="menu_product_card_gallery"
            name="Card Gallery"
            action="action_product_card_gallery"
            parent="product.menu_product_template_action_all"
            sequence="99"/>

</odoo>